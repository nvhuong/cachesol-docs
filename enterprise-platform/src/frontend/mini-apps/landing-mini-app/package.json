{
  "name": "@cachesol/landing-mini-app",
  "version": "1.0.0",
  "description": "Public landing page — khách xem thông tin từng mini-app và đăng ký qua Platform Registry",
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./manifest": {
      "types": "./src/manifest/types.ts",
      "import": "./src/manifest/types.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@cachesol/design-system": "workspace:*",
    "@cachesol/shared-types": "workspace:*",
    "@cachesol/shared-ui": "workspace:*",
    "antd": "^5.21.0",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.4.5",
    "vite": "^5.3.1"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  }
}
