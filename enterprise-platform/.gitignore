# ==============================================
# CacheSol Enterprise Platform — .gitignore
# ==============================================

# --- IDE & Editor ---
.vscode/
.idea/
.kilo/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Maven (Backend) ---
**/target/
!.mvn/wrapper/maven-wrapper.jar
**/*.class
**/*.jar
!**/src/main/resources/*.xml

# --- Gradle (Backend) ---
**/.gradle/
**/build/

# --- npm / Node (Frontend) ---
**/node_modules/
**/.npm/
**/.yarn/
src/frontend/**/dist/
src/frontend/**/*.tsbuildinfo

# --- Logs ---
**/logs/
**/*.log
**/*.log.gz

# --- Environment & Secrets ---
.env
.env.*
*.env
!.env.example

# --- Credentials & Keys ---
**/*.pem
**/*.p12
**/*.jks
**/credentials.json
**/service-account.json

# --- Container / DevOps ---
**/Dockerfile
**/docker-compose*.yml
**/.docker/

# --- Docs ở root level ---
# LƯU Ý: design-system/ ở root là MARKDOWN DOCS (components, patterns, tokens, templates) — VẪN TRACK trong git.
# Code library @cachesol/design-system nằm ở src/frontend/design-system/ (dist/ đã ignore ở trên).

# --- Temporary & Generated ---
*.tmp
*.bak
*.orig
**/__pycache__/
**/*.pyc
**/.cache/
**/.parcel-cache/

# --- Build artifacts ---
**/*.tgz
**/*.zip
**/*.tar

# --- macOS ---
.DS_Store
