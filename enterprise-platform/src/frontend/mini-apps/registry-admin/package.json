{
  "name": "@cachesol/registry-admin",
  "version": "1.0.0",
  "description": "Admin web cho Platform Registry — quản lý tenants, mini-apps, providers (Keycloak), audit logs.",
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./manifest": {
      "types": "./src/manifest/types.ts",
      "import": "./src/manifest/types.ts"
    }
  },
  "files": ["src"],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cachesol/design-system": "workspace:*",
    "@cachesol/shared-api": "workspace:*",
    "@cachesol/shared-types": "workspace:*",
    "@cachesol/shared-ui": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.22.0",
    "typescript": "^5.4.5",
    "vite": "^5.3.1"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  }
}
